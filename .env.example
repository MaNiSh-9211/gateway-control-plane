# gateway-control-plane/.env.example — template (committed)
# Copy to .env.dev for secrets:  cp .env.example .env.dev

JWT_SECRET=CHANGE_ME_must_match_dev_JWT_SECRET
ADMIN_API_KEY=CHANGE_ME_in_production

PORT=8081
HOST=0.0.0.0
CONFIG_DIR=./conf.d
CONFIG_HISTORY_LIMIT=20
MAX_CONCURRENCY=50000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

CONFIG_READ_TOKEN=

# Render / production upstreams (set in dashboard — NOT committed)
# UAM_BACKEND_UPSTREAM=uam-backend-ciqw.onrender.com:443
# DEMO_BACKEND_UPSTREAM=demo-backend-01dk.onrender.com:443

RUST_LOG=info
